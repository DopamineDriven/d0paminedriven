{
  "name": "@d0paminedriven/mdx",
  "version": "1.0.0",
  "description": "unopinionated mdx-to-react parser & processor that just works",
  "files": [
    "dist/**/*.{js,mjs,cjs,d.mts,d.ts,d.cts,css}"
  ],
  "license": "MIT",
  "sideEffecs": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*.d.cts",
          "dist/*/index.d.ts"
        ]
      }
    }
  },
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "lint": "eslint",
    "dev": "pnpm build",
    "prebuild": "rm -rf dist",
    "_postbuild": "tsx src/services/postbuild.ts flag-check",
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "clean": "git clean -xdf dist node_modules",
    "types": "tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "dependencies": {
    "@d0paminedriven/fs": "catalog:dd",
    "@mdx-js/react": "catalog:mdx",
    "@shikijs/transformers": "catalog:shiki",
    "katex": "catalog:katex",
    "rehype-katex": "catalog:rehype",
    "rehype-pretty-code": "catalog:rehype",
    "rehype-react": "catalog:rehype",
    "rehype-sanitize": "catalog:rehype",
    "rehype-stringify": "catalog:rehype",
    "remark-directive": "catalog:remark",
    "remark-gfm": "catalog:remark",
    "remark-math": "catalog:remark",
    "remark-parse": "catalog:remark",
    "remark-rehype": "catalog:remark",
    "unified": "catalog:unified",
    "vfile": "catalog:vfile",
    "yaml": "catalog:yaml"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@tsdown/css": "catalog:tsdown",
    "@types/katex": "catalog:katex",
    "@types/mdast": "catalog:mdast",
    "@types/mdx": "catalog:mdx",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@types/unist": "catalog:unist",
    "@typescript/native-preview": "catalog:tsgo",
    "autoprefixer": "catalog:styles",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "jsdom": "catalog:jsdom",
    "postcss": "catalog:styles",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "unist-util-remove": "catalog:unist",
    "unist-util-visit": "catalog:unist"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
