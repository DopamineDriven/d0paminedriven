{
  "extends": "@d0paminedriven/tsconfig/react-library.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "rootDir": "./src",
    "outDir": "dist",
        "ignoreDeprecations":"6.0",
    "types": ["*"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist"]
}
