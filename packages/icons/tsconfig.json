{
  "extends": "@d0paminedriven/tsconfig/react-library.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "declarationMap": false,
    "sourceMap": false,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "types": ["*"]
  },
  "include": [
    "**/*.ts",
    "src/**/*.tsx",
    "**/*.mjs",
    "**/*.preset.ts",
    "postcss.config.mjs",
    "index.d.ts",
    "tsup.config.ts"
  ],
  "exclude": ["dist"]
}
