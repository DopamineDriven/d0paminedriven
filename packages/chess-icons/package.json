{
  "name": "@d0paminedriven/chess-icons",
  "version": "1.0.0",
  "description": "a minimal react-package shipping chess icon svgs",
  "homepage": "https://github.com/DopamineDriven/d0paminedriven/blob/master/packages/chess-icons/README.md",
  "author": "Andrew Ross",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopamineDriven/d0paminedriven",
    "directory": "packages/chess-icons"
  },
  "files": [
    "dist/**/*.{js,mjs,cjs,d.mts,d.ts,d.cts,css,svg}"
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "icons": [
          "dist/icons/init.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./types": "./dist/types/index.js",
    "./icons": "./dist/icons/index.js",
    "./vectors/*": "./dist/vectors/*.svg"
  },
  "scripts": {
    "lint": "eslint",
    "dev": "pnpm build",
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "postbuild": "cp -r public dist/vectors",
    "clean": "git clean -xdf dist node_modules",
    "types": "tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": ">=19.2.1",
    "react-dom": ">=19.2.1"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20251206.1",
    "autoprefixer": "^10.4.22",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.1",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "terser": "^5.44.1",
    "tsdown": "^0.17.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
