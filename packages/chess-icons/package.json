{
  "name": "@d0paminedriven/chess-icons",
  "version": "0.5.0",
  "description": "a minimal react-package shipping chess icon svgs",
  "files": [
    "dist/**/*.{js,mjs,cjs,d.mts,d.ts,d.cts,css,svg}"
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "icons": [
          "dist/icons/init.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./types": "./dist/types/index.js",
    "./icons": "./dist/icons/index.js",
    "./vectors/*": "./dist/vectors/*.svg"
  },
  "scripts": {
    "lint": "eslint",
    "dev": "pnpm build",
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "postbuild": "cp -r public dist/vectors",
    "clean": "git clean -xdf dist node_modules",
    "types": "tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "chokidar": "^4.0.3",
    "eslint": "^9.28.0",
    "jiti": "^2.4.2",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "terser": "^5.42.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
