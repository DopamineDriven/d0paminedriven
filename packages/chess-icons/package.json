{
  "name": "@d0paminedriven/chess-icons",
  "version": "1.0.1",
  "description": "a minimal react-package shipping chess icon svgs",
  "homepage": "https://github.com/DopamineDriven/d0paminedriven/blob/master/packages/chess-icons/README.md",
  "author": "Andrew Ross",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopamineDriven/d0paminedriven",
    "directory": "packages/chess-icons"
  },
  "files": [
    "dist/**/*.{js,mjs,cjs,d.mts,d.ts,d.cts,css,svg}"
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "icons": [
          "dist/icons/init.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./types": "./dist/types/index.js",
    "./icons": "./dist/icons/index.js",
    "./vectors/*": "./dist/vectors/*.svg"
  },
  "scripts": {
    "lint": "eslint",
    "dev": "pnpm build",
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "postbuild": "cp -r public dist/vectors",
    "clean": "git clean -xdf dist node_modules",
    "types": "tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": ">=19.2.4",
    "react-dom": ">=19.2.4"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "catalog:tsgo",
    "autoprefixer": "^10.4.23",
    "chokidar": "^5.0.0",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "postcss": "^8.5.6",
    "prettier": "catalog:prettier",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "terser": "^5.46.0",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsup": "^8.5.1",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
