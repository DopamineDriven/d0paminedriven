    "react-dom": "^19.2.4",
    "rolldown": "1.0.0-rc.1",
    "rolldown-plugin-dts": "^0.21.7",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsup": "^8.5.1",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "unplugin-lightningcss": "^0.4.5"
  },
  "prettier": "@d0paminedriven/prettier-config"
