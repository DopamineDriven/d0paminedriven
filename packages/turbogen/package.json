{
  "name": "@d0paminedriven/turbogen",
  "version": "5.6.0",
  "description": "rapidly generate a turbo-powered pnpm workspace",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "bin": [
          "dist/bin/init.d.ts"
        ],
        "config": [
          "dist/config/index.d.ts"
        ],
        "services/cli": [
          "dist/services/cli/inquirer.d.ts",
          "dist/services/cli/index.d.ts"
        ],
        "services/scaffold": [
          "dist/services/scaffold/tooling/ts-scaffold.d.ts",
          "dist/services/scaffold/tooling/prettier-scaffold.d.ts",
          "dist/services/scaffold/tooling/jest-scaffold.d.ts",
          "dist/services/scaffold/tooling/eslint-scaffold.d.ts",
          "dist/services/scaffold/root/root-scaffolder.d.ts",
          "dist/services/scaffold/apps/generic-scaffold.d.ts",
          "dist/services/scaffold/packages/ui.d.ts",
          "dist/services/scaffold/index.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "bin": {
    "ddturbogen": "dist/bin/init.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "bin": [
        "dist/bin/init.d.ts"
      ],
      "config": [
        "dist/config/index.d.ts"
      ],
      "services/cli": [
        "dist/services/cli/inquirer.d.ts",
        "dist/services/cli/index.d.ts"
      ],
      "services/scaffold": [
        "dist/services/scaffold/tooling/ts-scaffold.d.ts",
        "dist/services/scaffold/tooling/prettier-scaffold.d.ts",
        "dist/services/scaffold/tooling/jest-scaffold.d.ts",
        "dist/services/scaffold/tooling/eslint-scaffold.d.ts",
        "dist/services/scaffold/root/root-scaffolder.d.ts",
        "dist/services/scaffold/apps/generic-scaffold.d.ts",
        "dist/services/scaffold/packages/ui.d.ts",
        "dist/services/scaffold/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./bin": "./dist/bin/init.js",
    "./config": "./dist/config/index.js",
    "./services/cli": "./dist/services/cli/index.js",
    "./services/cli/inquirer": "./dist/services/cli/inquirer.js",
    "./services/scaffold": "./dist/services/scaffold/index.js",
    "./services/scaffold/apps/generic-scaffold": "./dist/services/scaffold/apps/generic-scaffold.js",
    "./services/scaffold/packages/ui": "./dist/services/scaffold/packages/ui.ts",
    "./services/scaffold/root/root-scaffolder": "./dist/services/scaffold/root/root-scaffolder.js",
    "./services/scaffold/tooling/eslint-saffold": "./dist/services/scaffold/tooling/eslint-scaffold.js",
    "./services/scaffold/tooling/jest-scaffold": "./dist/services/scaffold/tooling/jest-scaffold.js",
    "./services/scaffold/tooling/prettier-scaffold": "./dist/services/scaffold/tooling/prettier-scaffold.js",
    "./services/scaffold/tooling/ts-scaffold": "./dist/services/scaffold/tooling/ts-scaffold.js",
    "./types": "./dist/types/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "pnpm build",
    "lint": "eslint",
    "clean": "git clean -xdf .turbo dist node_modules",
    "fix": "npm pkg fix"
  },
  "dependencies": {
    "@d0paminedriven/fs": "^6.1.0",
    "@inquirer/core": "^10.1.15",
    "@inquirer/prompts": "^7.8.3",
    "dotenv": "^17.2.1",
    "gradient-string": "^3.0.0"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@inquirer/type": "^3.0.8",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^24.3.0",
    "chokidar": "^4.0.3",
    "dotenv-cli": "^10.0.0",
    "dotenv-expand": "^12.0.2",
    "eslint": "^9.33.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "terser": "^5.43.1",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
