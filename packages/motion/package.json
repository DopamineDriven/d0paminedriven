{
  "name": "@d0paminedriven/motion",
  "version": "4.0.0",
  "description": "a text-animation-based react library built on motion",
  "author": "Andrew Ross",
  "homepage": "https://github.com/DopamineDriven/d0paminedriven/blob/master/packages/motion/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopamineDriven/d0paminedriven",
    "directory": "packages/motion"
  },
  "files": [
    "dist/**/*.{js,mjs,cjs,d.mts,d.ts,d.cts,css,svg}"
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*.d.cts",
        "dist/*/index.d.ts"
      ],
      "hooks": [
        "dist/hooks/use-gentle-text-effect.d.ts",
        "dist/hooks/use-resize-observer.d.ts"
      ],
      "types": [
        "dist/types/gentle-text.d.ts",
        "dist/types/helpers.d.ts",
        "dist/types/hooks.d.ts",
        "dist/types/scatter-text.d.ts",
        "dist/types/split-text.d.ts",
        "dist/types/wave-text.d.ts"
      ],
      "ui": [
        "dist/ui/gentle-text.d.ts",
        "dist/ui/scatter-text.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*.d.cts",
          "dist/*/index.d.ts"
        ],
        "hooks": [
          "dist/hooks/use-gentle-text-effect.d.ts",
          "dist/hooks/use-resize-observer.d.ts"
        ],
        "types": [
          "dist/types/gentle-text.d.ts",
          "dist/types/helpers.d.ts",
          "dist/types/hooks.d.ts",
          "dist/types/scatter-text.d.ts",
          "dist/types/split-text.d.ts",
          "dist/types/wave-text.d.ts"
        ],
        "ui": [
          "dist/ui/gentle-text.d.ts",
          "dist/ui/scatter-text.d.ts"
        ]
      }
    }
  },
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./types/*": "./dist/types/*.js",
    "./hooks/use-gentle-text-effect": "./dist/hooks/use-gentle-text-effect.js",
    "./hooks/use-resize-observer": "./dist/hooks/use-resize-observer.js",
    "./ui/gentle-text": "./dist/ui/gentle-text.js",
    "./ui/scatter-text": "./dist/ui/scatter-text.js"
  },
  "scripts": {
    "lint": "eslint",
    "dev": "pnpm build",
    "prebuild": "rm -rf dist",
    "postbuild": "tsx src/services/postbuild.ts flag-check",
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "clean": "git clean -xdf dist node_modules",
    "types": "tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:tw"
  },
  "dependencies": {
    "lodash.throttle": "catalog:lodash",
    "motion": "catalog:motion",
    "motion-dom": "catalog:motion",
    "motion-plus": "https://api.motion.dev/registry.tgz?package=motion-plus&version=2.12.0",
    "motion-plus-dom": "catalog:motion",
    "motion-utils": "catalog:motion"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/fs": "catalog:dd",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@d0paminedriven/vitest-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:tw",
    "@tsdown/css": "catalog:tsdown",
    "@types/lodash.throttle": "catalog:lodash",
    "@types/jsdom": "catalog:jsdom",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@typescript/native-preview": "catalog:tsgo",
    "autoprefixer": "catalog:styles",
    "clsx": "catalog:clsx",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "jsdom": "catalog:jsdom",
    "postcss": "catalog:styles",
    "postcss-import": "catalog:styles",
    "postcss-load-config": "catalog:styles",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "rolldown": "catalog:rolldown",
    "rolldown-plugin-dts": "catalog:rolldown",
    "tailwindcss": "catalog:tw",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint",
    "unplugin-lightningcss": "catalog:lightningcss",
    "vitest": "catalog:vitest"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
