{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@d0paminedriven/tsconfig/react-library.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["*"]
  },

  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist"]
}
