{
  "name": "@d0paminedriven/metadata",
  "version": "4.0.1",
  "description": "convenient metadata extraction helpers",
  "author": "Andrew Ross",
  "repository": {
    "type": "git",
    "url": "https://github.com/DopamineDriven/d0paminedriven/tree/master/packages/metadata"
  },
  "homepage": "https://github.com/DopamineDriven/d0paminedriven/blob/master/packages/metadata/README.md",
  "files": [
    "dist/**/*.{js,mjs,cjs,d.mts,d.ts,d.cts}"
  ],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "images": [
        "dist/images/index.d.ts",
        "dist/images/workup.d.ts"
      ],
      "docs": [
        "dist/docs/index.d.ts"
      ],
      "extract": [
        "dist/extract/index.d.ts",
        "dist/extract/client.d.ts"

      ],
      "mixins": [
        "dist/mixins/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "images": [
          "dist/images/index.d.ts",
          "dist/images/workup.d.ts"
        ],
        "docs": [
          "dist/docs/index.d.ts"
        ],
        "extract": [
          "dist/extract/index.d.ts",
          "dist/extract/client.d.ts"
        ],
        "mixins": [
          "dist/mixins/index.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "source": "src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./docs": "./dist/docs/index.js",
    "./extract": "./dist/extract/index.js",
    "./extract/client": "./dist/extract/client.js",
    "./images": "./dist/images/index.js",
    "./images/workup": "./dist/images/workup.js",
    "./mixins": "./dist/mixins/index.js",
    "./types": "./dist/types/index.js"
  },
  "scripts": {
    "lint": "eslint",
    "dev": "pnpm build",
    "prebuild": "rm -rf dist",
    "build": "tsdown",
    "clean": "git clean -xdf dist node_modules",
    "types": "tsc --emitDeclarationOnly",
    "pretest":"tsx src/test/output-local.ts",
    "test": "tsx src/test/index.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "^7.6.0",
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "terser": "^5.44.1",
    "tsdown": "^0.16.6",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
