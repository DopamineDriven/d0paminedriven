{
  "name": "@d0paminedriven/types",
  "version": "2.0.0",
  "description": "convenient type helpers",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/index.d.ts"
        ],
        "events-images": [
          "dist/events-images.d.ts"
        ],
        "events-workup": [
          "dist/events-workup.d.ts"
        ],
        "events": [
          "dist/events.d.ts"
        ],
        "models": [
          "dist/models.d.ts"
        ],
        "utils": [
          "dist/utils.d.ts"
        ],
        "types": [
          "dist/types.d.ts"
        ],
        "codegen": [
          "dist/codegen/*.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "events-images": [
        "dist/events-images.d.ts"
      ],
      "events-workup": [
        "dist/events-workup.d.ts"
      ],
      "events": [
        "dist/events.d.ts"
      ],
      "models": [
        "dist/models.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "codegen": [
        "dist/codegen/*.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils.js",
    "./types": "./dist/types.js",
    "./models": "./dist/models.js",
    "./events-images": "./dist/events-images.js",
    "./events-workup": "./dist/events-workup.js",
    "./events": "./dist/events.js",
    "./codegen/*": "./dist/codegen/*.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml}\" --ignore-unknown --cache",
    "clean": "git clean -xdf .turbo dist node_modules",
    "gen": "pnpm tsx src/codegen/index.ts"
  },
  "dependencies": {
    "@d0paminedriven/fs": "^11.0.0",
    "dotenv": "catalog:dotenv"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "prettier": "catalog:prettier",
    "rolldown": "1.0.0-rc.11",
    "rolldown-plugin-dts": "^0.22.5",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
