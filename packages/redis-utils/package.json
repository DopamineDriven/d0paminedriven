        ],
        "env": [
          "dist/env.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "redis": [
        "dist/redis.d.ts"
      ],
      "env": [
        "dist/env.d.ts"
      ]
    }
  },
  "type": "module",
