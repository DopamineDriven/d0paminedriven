{
  "name": "@d0paminedriven/redis-utils",
  "version": "2.0.0",
  "description": "convenient redis utils",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "redis": [
          "dist/redis.d.ts"
        ],
        "env": [
          "dist/env.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "redis": [
        "dist/redis.d.ts"
      ],
      "env": [
        "dist/env.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,d.ts,d.cts,css}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./redis": "./dist/redis.js",
    "./env": "./dist/env.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "pnpm build",
    "lint": "eslint",
    "clean": "git clean -xdf .turbo dist node_modules",
    "fix": "npm pkg fix",
    "test": "jest"
  },
  "peerDependencies": {
    "redis": ">=5.5.6"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "dotenv-expand": "^12.0.2"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/jest-presets": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "chokidar": "^4.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "redis": "^5.5.6",
    "terser": "^5.42.0",
    "ts-jest": "^29.3.4",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
