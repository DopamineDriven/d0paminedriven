{
  "name": "@d0paminedriven/root",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/DopamineDriven/d0paminedriven",
    "type": "git"
  },
  "private": true,
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8",
  "scripts": {
    "build:chess-icons": "turbo build --filter=@d0paminedriven/chess-icons",
    "build:fs": "turbo build --filter=@d0paminedriven/fs",
    "build:iso-3166-1": "turbo build --filter=@d0paminedriven/iso-3166-1",
    "build:mdx": "turbo build --filter=@d0paminedriven/mdx",
        "build:metadata": "turbo build --filter=@d0paminedriven/metadata",
    "build:motion": "turbo build --filter=@d0paminedriven/motion",
    "build:redis-utils": "turbo build --filter=@d0paminedriven/redis-utils",
    "build:targeted": "pnpm build:chess-icons && pnpm build:fs && pnpm build:iso-3166-1 && pnpm build:redis-utils && pnpm build:types && pnpm build:metadata && pnpm build:turbogen && pnpm build:ui && pnpm build:motion",
    "build:turbogen": "turbo build --filter=@d0paminedriven/turbogen",
    "build:types": "turbo build --filter=@d0paminedriven/types",
    "build:ui": "turbo build --filter=@d0paminedriven/ui",
    "build:web": "turbo build --filter=@d0paminedriven/web",
    "built:it": "bash ./manage.sh build",
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev --parallel --continue",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,mjs,cjs,json,yaml,yml,css,html,md,mdx}\" --ignore-unknown --cache",
    "lint": "turbo lint",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "clean:house": "bash ./manage.sh clean:house",
    "postclean:house": "pnpm --filter=@d0paminedriven/web typegen",
    "generate:base64": "openssl rand -base64 64",
    "generate:hex": "openssl rand -hex 64",
    "npm:registry": "npm set registry https://registry.npmjs.org",
    "run:web": "turbo dev --filter=@d0paminedriven/web",
    "latest:pnpm": "corepack use pnpm@latest",
    "wsl2:info": "lsb_release -a"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@changesets/cli": "^2.29.7",
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "knip": "^5.70.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vercel": "^48.10.7"
  },
  "prettier": "@d0paminedriven/prettier-config",
  "engines": {
    "node": ">=22",
    "npm": ">=10",
    "pnpm": ">=9"
  }
}
