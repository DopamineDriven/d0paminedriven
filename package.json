{
  "name": "@d0paminedriven/root",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912",
  "scripts": {
    "build:chess-icons": "turbo build --filter=@d0paminedriven/chess-icons",
    "build:fs": "turbo build --filter=@d0paminedriven/fs",
    "build:iso-3166-1": "turbo build --filter=@d0paminedriven/iso-3166-1",
    "build:motion": "turbo build --filter=@d0paminedriven/motion",
    "build:redis-utils": "turbo build --filter=@d0paminedriven/redis-utils",
    "build:targeted": "pnpm build:chess-icons && pnpm build:fs && pnpm build:iso-3166-1 && pnpm build:redis-utils && pnpm build:turbogen && pnpm build:ui && pnpm build:motion",
    "build:turbogen": "turbo build --filter=@d0paminedriven/turbogen",
    "build:ui": "turbo build --filter=@d0paminedriven/ui",
    "build:web": "turbo build --filter=@d0paminedriven/web",
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev --parallel --continue",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,mjs,cjs,json,yaml,yml,css,html,md,mdx}\" --ignore-unknown --cache",
    "lint": "turbo lint",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "clean:house": "cd tooling/eslint && git clean -xdf node_modules .turbo && cd ../prettier && git clean -xdf node_modules .turbo && cd ../typescript && git clean -xdf .turbo node_modules && cd ../jest-presets && git clean -xdf node_modules .turbo && cd ../../packages/chess-icons && git clean -xdf dist node_modules && cd ../ui && git clean -xdf dist node_modules && cd ../motion && git clean -xdf dist node_modules && cd ../fs && git clean -xdf dist node_modules && cd ../iso-3166-1 && git clean -xdf node_modules && cd ../redis-utils && git clean -xdf node_modules &&  cd ../.. && git clean -xdf node_modules pnpm-lock.yaml && pnpm install && pnpm build:targeted",
    "generate:base64": "openssl rand -base64 64",
    "generate:hex": "openssl rand -hex 64",
    "npm:registry": "npm set registry https://registry.npmjs.org",
    "run:web": "turbo dev --filter=@d0paminedriven/web",
    "latest:pnpm": "corepack use pnpm@latest",
    "update:pnpm": "curl -fsSL https://get.pnpm.io/install.sh | sh -"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/prettier-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@types/node": "^22.15.30",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "prettier": "@d0paminedriven/prettier-config",
  "engines": {
    "node": ">=22",
    "npm": ">=10",
    "pnpm": ">=9"
  }
}
