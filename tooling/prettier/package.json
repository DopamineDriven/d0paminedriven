{
  "name": "@d0paminedriven/prettier-config",
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts}"
  ],
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/index.d.ts"
        ]
      }
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "source": "index.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .turbo node_modules dist",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:prettier",
    "prettier": "catalog:prettier",
    "prettier-plugin-tailwindcss": "catalog:prettier"
  },
  "devDependencies": {
    "@d0paminedriven/eslint-config": "workspace:*",
    "@d0paminedriven/tsconfig": "workspace:*",
    "@typescript/native-preview": "catalog:tsgo",
    "@types/node": "catalog:node",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript-eslint": "catalog:tseslint",
    "typescript": "catalog:ts"
  },
  "prettier": "@d0paminedriven/prettier-config"
}
