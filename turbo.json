{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "ui": "stream",
  "globalEnv": [
    "__NEXT_PROCESSED_ENV",
    "ANTHROPIC_API_KEY",
    "BLOB_READ_WRITE_TOKEN",
    "CI_ENV",
    "CODE_SANDBOX_TOKEN",
    "COREPACK_ENABLE_STRICT",
    "DATABASE_URL",
    "DATABASE_API_KEY",
    "DIRECT_URL",
    "ECS_TASK_ARN",
    "ECS_TASK_DEFINITION",
    "EDITOR",
    "ENCRYPTION_KEY",
    "GA_MEASUREMENT_ID",
    "GA_PROTOCOL_SECRET",
    "GA_STREAM_ID",
    "GEMINI_API_KEY",
    "GEMINI_CACHE_TTL_SECONDS",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_PAT",
    "GOOGLE_API_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_CACHE_TTL_SECONDS",
    "HOME",
    "HOSTTYPE",
    "JWT_SECRET",
    "LLAMA_API_KEY",
    "LOGNAME",
    "MEASUREMENT_PROTOCOL_SECRET",
    "MOTION_PLUS_PERSONAL_ACCESS_TOKEN",
    "MY_GITHUB_PAT",
    "NEXTAUTH_SECRET",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "NEXT_PUBLIC_MEASUREMENT_PROTOCOL_SECRET",
    "NEXT_PUBLIC_GA_PROTOCOL_SECRET",
    "NEXT_PUBLIC_GA_STREAM_ID",
    "NPM_RC",
    "npm_config_user_agent",
    "NO_COLOR",
    "NODE_ENV",
    "NPM_TOKEN",
    "OLDPWD",
    "OPEN_AI_KEY",
    "OPENAI_API_KEY",
    "OPTIMIZE_API_KEY",
    "PATH",
    "PRISMA_SERVICE_TOKEN",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD",
    "PWD",
    "REDIS_CA_PATH",
    "REDIS_CA_PEM",
    "REDIS_CLIENT_CERT",
    "REDIS_CLIENT_KEY",
    "REDIS_HOST",
    "REDIS_URL",
